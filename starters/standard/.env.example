# WorkOS Configuration
# Get these from https://dashboard.workos.com/
WORKOS_CLIENT_ID=client_xxx
WORKOS_API_KEY=sk_xxx

# Redirect URI - must match the login redirect registered in the WorkOS dashboard
WORKOS_REDIRECT_URI=http://localhost:3000/auth/callback

# Cookie password for encrypting the AuthKit session (32+ characters)
# Generate with: openssl rand -base64 24
WORKOS_COOKIE_PASSWORD=your-32-character-or-longer-password-here

# Convex (set automatically by `npx convex dev`)
# VITE_CONVEX_URL=https://xxx.convex.cloud

# IMPORTANT: Convex functions do NOT read this file. The Convex deployment
# needs its own copies of the WorkOS variables for JWT validation and user
# provisioning:
#   npx convex env set WORKOS_CLIENT_ID client_xxx
#   npx convex env set WORKOS_API_KEY sk_xxx
